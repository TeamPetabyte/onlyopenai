# ── Dependencies ─────────────────────────────────────────
node_modules/

# ── Knowledge-base document binaries (PDF/DOCX manuals) ──
# Already indexed in the shared OpenAI vector store — deploy
# machines don't need the raw files, and 30MB+ binaries would
# bloat the repo forever. The .txt files stay tracked because
# function tools read them from disk directly.
server/knowledge/*.pdf
server/knowledge/*.doc
server/knowledge/*.docx
server/knowledge/*.htm
server/knowledge/*.html

# ── Secrets / env (never commit) ─────────────────────────
.env
.env.local
.env.production
server/.env

# ── Local tooling / editor / agent state ─────────────────
.claude/
.DS_Store
*.swp

# ── Logs ─────────────────────────────────────────────────
logs/
*.log

# ── DB data backups (clean-slate dumps — never commit) ───
backups/

# ── Local UI mockups (design scratch, not shipped) ───────
_ux-mockup/

# ── Legacy / archived code (kept on disk, out of git+deploy) ─
_archive/
dist/
